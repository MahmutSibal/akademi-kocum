# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env repoya EKLENMEZ. Değerlerde tırnak ("), dolar ($) ve boşluk kullanmayın.

# --- Çalışma modu -------------------------------------------------------------
# mssql,ollama   -> her şey Docker'da (varsayılan, teslim/demo)
# mssql          -> SQL Server Docker'da, Ollama bilgisayarda (OLLAMA_BASE_URL=http://host.docker.internal:11434)
# (boş)          -> SQL Server ve Ollama bilgisayarda (APP_DB_HOST=host.docker.internal, scripts/init-local.ps1)
COMPOSE_PROFILES=mssql,ollama

# --- SQL Server ---------------------------------------------------------------
# Host modu: init-local.ps1 bu instance'a Windows kimlik doğrulamasıyla bağlanır.
#   .            -> varsayılan instance (MSSQLSERVER)
#   .\SQLEXPRESS -> adlandırılmış instance
LOCAL_SQL_INSTANCE=.

# Yalnızca Docker modu (sqlserver konteyneri). Karmaşıklık kuralı:
# en az 8 karakter, büyük + küçük harf, rakam, sembol
MSSQL_SA_PASSWORD=Degistir_Bunu_2026!
# Developer (ücretsiz, tam özellik) veya Express
MSSQL_PID=Developer
MSSQL_PORT=1433

# n8n'in bağlanacağı uygulama kullanıcısı (sadece okuma/yazma yetkisi).
# Docker modu: sqlserver / 1433 — host modu: host.docker.internal / 1433
APP_DB_HOST=sqlserver
APP_DB_PORT=1433
APP_DB_USER=study_app
APP_DB_PASSWORD=Uygulama_Sifresi_2026!

# --- Ollama -------------------------------------------------------------------
# Docker modu: http://ollama:11434   Bilgisayardaki Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Donanıma göre seçin:
#   ~8 GB RAM, GPU yok    -> qwen2.5:3b   (~2 GB)
#   6-8 GB GPU            -> qwen2.5:7b   (~4.7 GB, iyi Türkçe + JSON)
#   12+ GB GPU / 32 GB RAM -> gemma4:12b  (~8 GB)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
# Defter fotoğrafından not okuma için görsel model (vision destekli, düşünme modu kapatılabilen: gemma4:12b)
OLLAMA_VISION_MODEL=gemma4:12b
OLLAMA_VISION_TIMEOUT_MS=600000
# Modele gönderilen en uzun not metni (karakter)
MAX_LLM_INPUT_CHARS=12000
OLLAMA_TIMEOUT_MS=180000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_PORT=11434

# --- n8n ----------------------------------------------------------------------
# Rastgele uzun bir değer üretin; sonradan DEĞİŞTİRMEYİN (credential'lar bununla şifrelenir)
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=buraya-64-karakterlik-rastgele-hex-yazin
N8N_VERSION=latest
N8N_PORT=5678
N8N_HOST=localhost
# Gerçek telefondan test için bilgisayarın LAN IP'sini yazın, ör. http://192.168.1.25:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Brevo SMTP --------------------------------------------------------------
# Brevo SMTP API key'i parola olarak kullanılır; bu değeri repoya koymayın.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=b60130001@smtp-brevo.com
BREVO_SMTP_PASSWORD=
BREVO_SMTP_FROM_EMAIL=
BREVO_SMTP_FROM_NAME=Akademi Koçum
# true: her pazartesi 09:00 aktif kullanıcılara haftalık rapor e-postası gönderilir
WEEKLY_REPORT_ENABLED=false

# --- Uygulama -----------------------------------------------------------------
CHAT_HISTORY_LIMIT=10
QUIZ_MAX_RETRIES=2
# Bonus: JWT yetkilendirme için (openssl rand -hex 32)
JWT_SECRET=

TZ=Europe/Istanbul
